# 复制本文件为 .env 后填入真实值
IMAGE_API_BASE=https://api.example.com
IMAGE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
IMAGE_API_MODEL=gpt-image-2

# 生产建议开启鉴权
AUTH_REQUIRED=true
APP_ACCESS_TOKEN=replace-with-a-strong-random-token

# 保护阈值
MAX_PROMPT_CHARS=800
MAX_IMAGES_PER_REQUEST=1
MAX_PIXEL_COUNT=5530000
DAILY_LIMIT_PER_CLIENT=40
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=12
UPSTREAM_TIMEOUT_MS=30000

PORT=3000
