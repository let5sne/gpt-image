# Image Studio 兑换码运营模式配置模板
# 复制本文件为 .env 后填入真实值。当前推荐模式：
# - 用户无需注册登录
# - 购买/领取兑换码后兑换 credits
# - 浏览器本机保存钱包凭证，生成图片时自动扣减 credits
# - 邮箱登录、Replicate、S3、数据库均为可选增强项

# ── 服务基础 ────────────────────────────────────────────
PORT=3000

# ── 图片生成供应商：默认 OpenAI-compatible / sub2api ─────
# 当前线上采用 OpenAI-compatible 方式请求内部 sub2api，不直接走 Replicate。
# 如果你的 sub2api 与本服务在同一 Docker 网络，可使用类似 http://sub2api:8080。
IMAGE_PROVIDER=openai
IMAGE_API_BASE=http://sub2api:8080
IMAGE_API_KEY=replace-with-provider-api-key
IMAGE_API_MODEL=gpt-image-2
IMAGE_API_BYPASS_SECRET=replace-with-a-strong-random-bypass-secret

# OpenAI-compatible 供应商前缀变量，按需填写；未填会回退到通用 IMAGE_API_*。
OPENAI_IMAGE_API_BASE=
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_API_MODEL=
OPENAI_IMAGE_API_BYPASS_SECRET=

OPENROUTER_IMAGE_API_BASE=
OPENROUTER_IMAGE_API_KEY=
OPENROUTER_IMAGE_API_MODEL=
OPENROUTER_IMAGE_API_BYPASS_SECRET=

SILICONFLOW_IMAGE_API_BASE=
SILICONFLOW_IMAGE_API_KEY=
SILICONFLOW_IMAGE_API_MODEL=
SILICONFLOW_IMAGE_API_BYPASS_SECRET=

TOGETHER_IMAGE_API_BASE=
TOGETHER_IMAGE_API_KEY=
TOGETHER_IMAGE_API_MODEL=
TOGETHER_IMAGE_API_BYPASS_SECRET=

MINIMAX_IMAGE_API_BASE=
MINIMAX_IMAGE_API_KEY=
MINIMAX_IMAGE_API_MODEL=
MINIMAX_IMAGE_API_BYPASS_SECRET=

DOUBAO_IMAGE_API_BASE=
DOUBAO_IMAGE_API_KEY=
DOUBAO_IMAGE_API_MODEL=
DOUBAO_IMAGE_API_BYPASS_SECRET=

VOLCENGINE_IMAGE_API_BASE=
VOLCENGINE_IMAGE_API_KEY=
VOLCENGINE_IMAGE_API_MODEL=
VOLCENGINE_IMAGE_API_BYPASS_SECRET=

# ── 可选：Replicate 异步任务模式 ─────────────────────────
# 只有设置 IMAGE_PROVIDER=replicate 时才需要这些变量。
REPLICATE_API_TOKEN=
REPLICATE_MODEL=openai/gpt-image-2
REPLICATE_QUALITY=auto
REPLICATE_BACKGROUND=auto
REPLICATE_MODERATION=auto
REPLICATE_OUTPUT_COMPRESSION=90
REPLICATE_POLL_INTERVAL_MS=2000
REPLICATE_MAX_POLL_MS=1200000
JOB_RETENTION_MS=900000

# ── 图片存储 ────────────────────────────────────────────
# 兑换码小规模运营默认 local 即可；生产如需 CDN，再切到 S3-compatible。
IMAGE_STORAGE_PROVIDER=local
IMAGE_STORAGE_PUBLIC_BASE_URL=
IMAGE_STORAGE_PREFIX=
IMAGE_STORAGE_UPLOAD_TIMEOUT_MS=30000

# 可选：S3-compatible（Cloudflare R2 / AWS S3 / OSS S3 API 等）
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ── 兑换码 + credits：当前运营核心 ───────────────────────
CREDITS_ENABLED=true
# Docker 生产环境应使用容器内路径，保持与 volume 映射一致。
CREDITS_FILE=/app/storage/credits.json
CREDIT_CODE_PEPPER=replace-with-a-strong-random-pepper
# Replicate gpt-image-2 当前约 $0.13/张。统一 20 credits/张，按现有三档包价
# 约可维持 43%-53% 毛利，避免 Low/Medium 低价档亏损。
CREDIT_COST_REPLICATE_GPT_IMAGE_2_LOW=20
CREDIT_COST_REPLICATE_GPT_IMAGE_2_MEDIUM=20
CREDIT_COST_REPLICATE_GPT_IMAGE_2_AUTO=20
CREDIT_COST_REPLICATE_GPT_IMAGE_2_HIGH=20

# ── 访问控制与运营后台 ─────────────────────────────────
# 前端公开访问时如不需要 App Token，可改为 AUTH_REQUIRED=false。
# 当前线上开启鉴权，同时用户侧仍通过兑换码钱包消费 credits。
AUTH_REQUIRED=true
APP_ACCESS_TOKEN=replace-with-a-strong-random-token
ADMIN_TOKEN=replace-with-a-different-strong-random-admin-token
ADMIN_GRANT_MAX_CREDITS=10000
ADMIN_BATCH_MAX_CODES=5000
ADMIN_BATCH_MAX_CREDITS_PER_CODE=100000
ADMIN_AUDIT_LOG_FILE=/app/storage/admin-audit.log

# ── 邮箱验证码用户系统：兑换码模式默认关闭 ───────────────
# 当前策略是不注册、不登录，只凭兑换码使用。后续如要开放自助账号，
# 先配置真实 SMTP，再设置 EMAIL_AUTH_ENABLED=true，且保持 DEV_MODE=false。
EMAIL_AUTH_ENABLED=false
EMAIL_AUTH_FILE=/app/storage/email-auth.json
EMAIL_AUTH_PEPPER=replace-with-a-strong-random-pepper
EMAIL_CODE_LENGTH=6
EMAIL_CODE_TTL_MS=600000
EMAIL_CODE_RESEND_COOLDOWN_MS=60000
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_SESSION_TTL_MS=2592000000
EMAIL_CODE_DEV_MODE=false
EMAIL_AUTH_COOKIE_NAME=ims_auth

# 可选：邮箱验证码 SMTP 投递
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_BRAND_NAME=Image Studio

# ── 可选：M2 数据库迁移 / 双写 ──────────────────────────
DATABASE_URL=
DB_DUAL_WRITE=false
# 读切换(独立于双写,各自默认关、可单独回滚)。仅在双写已激活且 db:reconcile 全绿后开启。
# admin overview 的 credits 聚合改从 DB 读(失败回退文件值,标 source=file-fallback)。
DB_READ_CREDITS_OVERVIEW=false
# admin redemption 列表(batches/codes)改从 DB 读(复用同一 JS 聚合,失败回退文件值)。
DB_READ_REDEMPTION_LISTS=false

# ── 保护阈值 ────────────────────────────────────────────
MAX_PROMPT_CHARS=4000
MAX_IMAGES_PER_REQUEST=1
MAX_PIXEL_COUNT=8300000
DAILY_LIMIT_PER_CLIENT=40
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=12
UPSTREAM_TIMEOUT_MS=120000
